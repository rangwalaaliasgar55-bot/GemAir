# ============================================================
# GemAir — Vercel environment variables (.env.example)
# Copy to .env (for `vercel dev`) and add to Vercel → Settings → Environment Variables.
# ============================================================

# --- Optional: AI chat (the whole app works FREE without this) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Or use any OpenAI-compatible provider:
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
#
# Google Gemini works through its OpenAI-compatible endpoint:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash          (key from https://aistudio.google.com/apikey)
# ChatGPT / OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini               (key from https://platform.openai.com/api-keys)

# --- Optional: Supabase for cloud memory (cross-device) ---
# Create a project at https://supabase.com. The schema in supabase/migrations/
# is applied automatically via the Supabase GitHub integration (production
# branch = main). Then enable "Anonymous sign-ins" under Auth → Providers.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Desktop account connections (Electron only) ---
# ChatGPT: use an OpenAI-approved OAuth client for this application.
GEMAIR_CHATGPT_CLIENT_ID=
# Gemini: create a Google OAuth Desktop client and allow:
# http://127.0.0.1:8766/callback
GEMAIR_GEMINI_CLIENT_ID=
GEMAIR_GEMINI_CLIENT_SECRET=
