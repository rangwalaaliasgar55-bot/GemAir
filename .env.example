# ============================================================
# GemAir — Vercel environment variables (.env.example)
# Copy to .env (for `vercel dev`) and add to Vercel → Settings → Environment Variables.
# ============================================================

# --- AI chat for the deployed web build ---
# READ THIS FIRST: /api/chat is a PROXY, not a free model service. With no key set it
# answers 503 NO_PROVIDERS_CONFIGURED (the app then uses a user-supplied key instead,
# and GemAir Desktop still works with no key at all). So this value is only optional if
# you do not intend anyone to chat through YOUR deployment.
#
# Groq is the cheapest to stand up: a free key, no card. Note the Llama 3.x ids were shut
# down on 2026-08-16 — the ids below are the current ones.
GROQ_API_KEY=
# Or any OpenAI-compatible provider:
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
#
# Google Gemini works through its OpenAI-compatible endpoint (free tier is Flash-only
# since 2026-05; the 2.0 family was retired 2026-06-01):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash          (key from https://aistudio.google.com/apikey)
# ChatGPT / OpenAI (paid API key — the Desktop app's "Connect ChatGPT" uses your own
# plan instead and needs none of this):
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-5.6-terra             (key from https://platform.openai.com/api-keys)
#
# AI_MODEL is optional: when it is unset, each provider's live /models list is queried
# and cached, so a retired id in this file no longer breaks the chain.

# --- Optional: Supabase for cloud memory (cross-device) ---
# Create a project at https://supabase.com. The schema in supabase/migrations/
# is applied automatically via the Supabase GitHub integration (production
# branch = main). Then enable "Anonymous sign-ins" under Auth → Providers.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Fair use on the shared proxy (optional) ---
# FAIR_USE_DAILY=200      # messages per identity per day (IP + signed-in user, both charged)
# THROTTLE_PER_MIN=12     # per-IP request ceiling
# ALLOWED_ORIGINS=your-app.example.com   # extra browser origins allowed to spend the keys
#
# --- Desktop account connections (Electron only) ---
# ChatGPT Desktop uses OpenAI device authorization + the account-backed Codex
# Responses transport. These are advanced compatibility overrides only;
# normal users leave them empty and press Connect ChatGPT in Settings.
GEMAIR_CHATGPT_CLIENT_ID=
GEMAIR_CHATGPT_ISSUER=
GEMAIR_CHATGPT_CODEX_BASE_URL=
GEMAIR_CHATGPT_CLIENT_VERSION=
GEMAIR_CHATGPT_ORIGINATOR=
# Gemini: create a Google OAuth Desktop client and allow:
# http://127.0.0.1:8766/callback
GEMAIR_GEMINI_CLIENT_ID=
GEMAIR_GEMINI_CLIENT_SECRET=
