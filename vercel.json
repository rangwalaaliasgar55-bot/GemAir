{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/download.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/app",
      "destination": "/desktop-only.html"
    },
    {
      "source": "/renderer/:path*",
      "destination": "/desktop-only.html"
    },
    {
      "source": "/index.html",
      "destination": "/desktop-only.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
