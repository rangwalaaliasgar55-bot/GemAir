{
  "name": "gemair",
  "version": "2.4.0",
  "description": "GemAir — a free, open-source JARVIS-style desktop assistant. A sci-fi command center for your PC: voice assistant, system core, agent town and world monitor.",
  "main": "main.js",
  "author": "GemAir",
  "license": "MIT",
  "homepage": "https://github.com/rangwalaaliasgar55-bot/GemAir",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preview": "electron . --dev --no-sandbox",
    "web": "npx serve renderer -l 8080",
    "serve": "node scripts/dev-server.js",
    "check": "node scripts/selfcheck.js && node scripts/workflow-test.js",
    "test:workflows": "node scripts/workflow-test.js",
    "dev:web": "vercel dev",
    "build:web": "echo 'GemAir web = static renderer/ + serverless api/. Deploy with: vercel'",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "@vercel/node": "^3.2.0"
  },
  "build": {
    "appId": "io.gemair.desktop",
    "productName": "GemAir",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GemAir"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons"
    }
  }
}
